# Example environment variables for Bookmarkify Web

# API/WS 接口地址，默认使用线上环境；如需连接本地后端，取消上面两行注释并注释掉下面两行
#NUXT_API_BASE='http://127.0.0.1:8001'
#NUXT_WS_BASE='ws://localhost:8001'
NUXT_API_BASE='https://bookmarkify.cc/api'
NUXT_WS_BASE='wss://bookmarkify.cc/ws'

# Google 登录 OAuth Client ID（留空则不显示谷歌登录按钮）
NUXT_PUBLIC_GOOGLE_CLIENT_ID=''
# GitHub 登录 OAuth App Client ID（留空则不显示 GitHub 登录按钮）
NUXT_PUBLIC_GITHUB_CLIENT_ID=''
