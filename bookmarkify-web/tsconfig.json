{
  "compilerOptions": {
    "types": ["node", "./types/vue-shim"],
    "paths": {
      "@api": ["./server/apis"],
      "@stores/*": ["./stores/*"],
      "@config": ["./server/config"],
      "@config/*": ["./server/config/*"],
      "@typing": ["./typing"],
      "@utils": ["./server/utils"],
      "@utils/*": ["./server/utils/*"]
    }
  },
  "vueCompilerOptions": {
    "globalTypesPath": "./.nuxt/volar.d.ts"
  },
  "extends": "./.nuxt/tsconfig.json",
  "exclude": ["archive/**/*"]
}
