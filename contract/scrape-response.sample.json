{
  "_comment": "bookmarkify-scrapper POST /scrape 的契约样例。Rust 侧 contract.rs 与 Kotlin 侧 ScrapeContract.kt 的测试都会反序列化本文件——两边任何一侧改了字段名或枚举取值，这里就会红。改契约请同时改这三个文件。以 '_' 开头的键是给人看的注释，两侧都会忽略。",

  "request": {
    "url": "https://github.com/vbenjs/vue-vben-admin",
    "render": {
      "mode": "AUTO",
      "timeoutMs": 15000,
      "waitUntil": "LOAD",
      "viewport": { "width": 1280, "height": 720, "dpr": 2.0 },
      "locale": "zh-CN",
      "colorScheme": "LIGHT"
    },
    "extract": {
      "meta": true,
      "assets": true,
      "manifest": true,
      "jsonld": true,
      "opengraph": true,
      "twitter": true,
      "feeds": false,
      "alternates": false,
      "text": false
    },
    "assets": { "download": "PROBE", "maxBytes": 2097152, "maxCount": 20 },
    "screenshot": { "enabled": false, "fullPage": false, "format": "WEBP", "quality": 80 },
    "cache": { "mode": "BYPASS" },
    "robots": { "respect": true }
  },

  "fetch": {
    "finalUrl": "https://github.com/vbenjs/vue-vben-admin",
    "redirectChain": [{ "url": "http://github.com/vbenjs/vue-vben-admin", "status": 301 }],
    "httpStatus": 200,
    "layerUsed": "HTTP",
    "fromCache": false,
    "contentType": "text/html; charset=utf-8",
    "charset": "utf-8",
    "byteSize": 482130,
    "tls": { "valid": true, "issuer": "DigiCert Inc", "notAfter": "2026-03-14T23:59:59Z" },
    "timingMs": { "dns": 12, "connect": 30, "tls": 45, "ttfb": 180, "total": 421 }
  },

  "_comment_meta": "字段级出处是本契约的核心：title 来自 OG，description 却回落到了 meta[name]，shortName 来自 manifest。旧契约的单一 source 会把这三者压扁成一个 'og'。",
  "meta": {
    "title": "GitHub - vbenjs/vue-vben-admin",
    "description": "A modern vue admin panel built with Vue3.",
    "siteName": "GitHub",
    "shortName": "GitHub",
    "canonicalUrl": "https://github.com/vbenjs/vue-vben-admin",
    "lang": "en",
    "themeColor": "#1e2327",
    "publishedAt": "2020-10-11T08:00:00Z",
    "robots": "index, follow",
    "keywords": ["vue", "admin", "vben"],
    "sources": {
      "title": { "extractor": "OG", "rawKey": "og:title" },
      "description": { "extractor": "META_NAME", "rawKey": "description" },
      "siteName": { "extractor": "OG", "rawKey": "og:site_name" },
      "shortName": { "extractor": "MANIFEST", "rawKey": "short_name" },
      "canonicalUrl": { "extractor": "LINK_TAG", "rawKey": "canonical" },
      "lang": { "extractor": "HTML_ATTR", "rawKey": "lang" },
      "publishedAt": { "extractor": "JSON_LD", "rawKey": "datePublished" }
    }
  },

