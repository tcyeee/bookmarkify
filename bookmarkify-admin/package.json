{
  "name": "bookmarkify-admin",
  "version": "5.5.9",
  "homepage": "https://bookmarkify.cc",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:packages && pnpm vite build --mode production",
    "build:packages": "node scripts/build-core-packages.mjs",
    "build:analyze": "VITE_VISUALIZER=true pnpm vite build --mode production",
    "dev": "pnpm vite --mode development",
    "preview": "vite preview",
    "typecheck": "node scripts/typecheck.mjs",
    "postinstall": "pnpm -r run stub --if-present",
    "typecheck:raw": "vue-tsc --noEmit --skipLibCheck"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "dependencies": {
    "@vben/access": "workspace:*",
    "@vben/common-ui": "workspace:*",
    "@vben/constants": "workspace:*",
    "@vben/hooks": "workspace:*",
    "@vben/icons": "workspace:*",
    "@vben/layouts": "workspace:*",
    "@vben/locales": "workspace:*",
    "@vben/plugins": "workspace:*",
    "@vben/preferences": "workspace:*",
    "@vben/request": "workspace:*",
    "@vben/stores": "workspace:*",
    "@vben/styles": "workspace:*",
    "@vben/types": "workspace:*",
    "@vben/utils": "workspace:*",
    "@vueuse/core": "^13.4.0",
    "dayjs": "^1.11.13",
    "element-plus": "^2.10.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "unplugin-element-plus": "^0.10.0",
    "@types/node": "^22.16.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "unbuild": "^3.5.0",
    "vite": "^6.3.5",
    "vue-tsc": "2.2.10",
    "@vben/vite-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/tailwind-config": "workspace:*"
  },
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.12.0"
  }
}
