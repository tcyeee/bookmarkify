# Bookmarkify Admin 环境变量示例
# 复制本文件为 .env 后按需修改（.env 已 gitignore）。
# 生产值不来自这里：CI 在 .github/workflows/deploy-admin.yml 里写 .env.production.local 注入。
#
# ⚠️ 只有 VITE_ 前缀的变量会生效。这是 Vite 项目，写 NUXT_xxx（bookmarkify-web 那套）
#    会被 internal/vite-config/src/utils/env.ts 的 `^(VITE_)` 正则静默丢弃，不报错也不生效。

# ─── 连哪个后端 ─────────────────────────────────────────────
# 就这一个开关，二选一。REST 和 WebSocket 会一起切，因为 vite.config.mts 里
# /api/admin 和 /ws 两条代理规则共用同一个 target。改完要重启 dev server。
VITE_PROXY_TARGET=http://localhost:8001
#VITE_PROXY_TARGET=https://bookmarkify.cc
#
# 和 bookmarkify-web 的差异（不是随意的，是架构决定的）：
#   web 的 nuxt.config.ts 没有配任何 dev proxy，dev 跑在 :3000，只能靠 NUXT_BACKEND
#   填绝对地址跨域直连后端；admin 有 vite dev proxy，所以前端代码里一律用相对路径，
#   换后端只动代理的落点。两边写法不同，但都是「一个变量、两个值、REST 和 WS 一起切」。

# 接口前缀。dev 和 prod 都是 /api，属于常量而非开关——真正决定打到哪台机器的是上面的
# VITE_PROXY_TARGET（本地）和 nginx（线上：/api/admin/** -> bookmarkify-api:7001/admin/**）。
# 指向本地时 vite 会自己剥掉 /api 前缀，指向线上时保留前缀交给 nginx 剥。
VITE_GLOB_API_URL=/api

# 注：VITE_GLOB_ 前缀的变量比较特殊，构建时会被 internal/vite-config 的 extra-app-config
# 插件烤进 dist/_app.config.js（挂到 window._VBEN_ADMIN_PRO_APP_CONF_）。其余 VITE_ 变量
# 只在构建期做静态替换。
# WebSocket 地址没有对应的变量：src/api/similarIngestSocket.ts 直接从当前页面 origin
# 推导（http->ws / https->wss），本地由上面的代理转发，线上由 nginx 的 location /ws 透传。

# ─── 应用标识 ───────────────────────────────────────────────
# 浏览器标签页标题，同时被 index.html 的 EJS 模板消费——缺失会导致构建直接失败
VITE_APP_TITLE=书签鸭 Admin
# localStorage / sessionStorage 的 key 前缀，多个 vben 应用同域部署时用于隔离
VITE_APP_NAMESPACE=bookmarkify-admin
# pinia 持久化状态的加密 key（含登录 token），改动会让所有已存在的本地状态失效、用户被登出
VITE_APP_STORE_SECURE_KEY=bookmarkify-admin-store-key

# ─── 开发服务器 ─────────────────────────────────────────────
# 本地开发端口
VITE_PORT=5777

# 部署基路径，对应 vite 的 base。部署在域名根目录就是 /，
# 挂子路径（如 https://x.com/admin/）时要改成 /admin/
VITE_BASE=/

# vue-router 的模式；生产必须为 hash——nginx 未配置 SPA 回退重写，
# 切到 history 模式会导致刷新非首页路由 404
VITE_ROUTER_HISTORY=hash

# 是否打开 vue devtools 面板，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否开启 Nitro Mock 服务，true 为开启，false 为关闭
# （本项目所有接口都打真实后端，保持 false）
VITE_NITRO_MOCK=false

# ─── 构建产物 ───────────────────────────────────────────────
# 是否注入全局 loading（首屏 JS 加载完成前的骨架动画）
VITE_INJECT_APP_LOADING=true

# 构建产物压缩，可以设置为 none, brotli, gzip（逗号分隔可多选）
# 线上由 nginx 负责压缩，这里保持 none
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# 打包后是否额外生成 dist.zip。本地留 true 方便手动分发；
# CI 里会被 .env.production.local 覆盖为 false（rsync 部署用不上压缩包）
VITE_ARCHIVER=true

# 是否生成构建产物体积分析报告（rollup-plugin-visualizer）。
# 无需写进文件，支持 shell 内联：`VITE_VISUALIZER=true pnpm build`
#VITE_VISUALIZER=false
